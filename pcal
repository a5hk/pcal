# HELP AND USER INTERFACE
################################################################################

# Display help message
# Shows usage information, available options, and examples
print_help() {
	echo "Usage: pcal [OPTIONS]"
	echo "  Convert Gregorian calendar date to Persian calendar date."
	echo ""
	echo "  Reads a Gregorian calendar date from standard input and prints "
	echo "  its corresponding Persian calendar date to standard output."
	echo ""
	echo "  Options:"
	echo "    -h          display this help and exit"
	echo "    -v          display version and exit"
	echo "    -d IDELIM   use IDELIM instead of - for input date delimiter"
	echo "    -D ODELIM   use ODELIM instead of - for output date delimiter"
	echo "    -g          convert Persian calendar date to Gregorian calendar date"
	echo "    -m          display current Persian month in calendar"
	echo "    -t          print current Persian date"
	echo ""
	echo "  Examples:"
	echo "    echo \"2019-07-26\" | pcal               # Output: 1398-05-04"
	echo "    echo \"2019/07/26\" | pcal -d /          # Custom input delimiter"
	echo "    echo \"2019-07-26\" | pcal -D /          # Output: 1398/05/04"
	echo "    echo \"1398-05-04\" | pcal -g            # Output: 2019-07-26"
	echo "    pcal -t                                 # Show current date"
	echo "    pcal -m                                 # Show calendar"
}

################################################################################
# MAIN FUNCTION AND OPTION PROCESSING
################################################################################

# Main function
# Processes command-line options and performs date conversion
# Args:
#   $@ - Command-line arguments
main() {
	local input_data
	local gregorian=0

	# Handle -- (end of options)
	local args=("$@")
	local new_args=()
	local stop_options=false
	for arg in "${args[@]}"; do
		if [[ "$stop_options" == true ]]; then
			new_args+=("$arg")
		elif [[ "$arg" == "--" ]]; then
			stop_options=true
		else
			new_args+=("$arg")
		fi
	done
	set -- "${new_args[@]}"

	# Process all options in a single pass
	while getopts ":hd:D:gmtv" opt; do
		case ${opt} in
		h)
			print_help # Show help message
			exit 0
			;;
		v)
			echo "pcal $PCAL_VERSION"
			exit 0
			;;
		d)
			OPTION_IDEL=$OPTARG # Set input delimiter
			;;
		D)
			OPTION_ODEL=$OPTARG # Set output delimiter
			;;
		g)
			gregorian=1 # Flag: convert Persian → Gregorian
			;;
		t)
			current_persian_date || exit 1 # Print today's Persian date
			exit 0
			;;
		m)
			print_current_month || exit 1 # Print Persian calendar
			exit 0
			;;
		\?)
			echo "Invalid Option: -$OPTARG" 1>&2
			exit 1
			;;
		:)
			echo "Invalid Option: -$OPTARG requires an argument" 1>&2
			exit 1
			;;
		esac
	done
	shift $((OPTIND - 1)) # Remove processed options from arguments

	# Read input from stdin or remaining arguments
	if [ -n "$1" ]; then
		input_data="$1" # Use command-line argument
	else
		# `read` returns non-zero on EOF even when it *did* capture a final
		# line with no trailing newline (e.g. printf "%s" "$date" | pcal), so
		# only treat this as "no input" when nothing was actually captured.
		read -r input_data
		if [[ -z "$input_data" ]]; then
			exit_error "No date provided (nothing on stdin, no argument)"
		fi
	fi

	# Perform date conversion
	local parsed
	parsed=$(parse_input "$input_data") || exit 1 # Parse into "year month day"
	if [[ $gregorian -eq 1 ]]; then
		to_gregorian $parsed || exit 1 # Persian → Gregorian
	else
		to_jalaali $parsed || exit 1 # Gregorian → Persian (default)
	fi
}

# Script entry point: pass all arguments to main function
# Guard allows sourcing this file without executing main
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
